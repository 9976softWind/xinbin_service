    <sql id="Base_Column_List">
        id, plan_file_id, plan_file_name, status, executor, start_time, end_time, last_feed_back_time
    </sql>
    <select id="getPlanFileExeFeedBackList" resultMap="PlanFileExeFeedBackResuleMap" parameterType="com.wims.iot.model.query.PlanFileExeFeedBackQuery">
        select
        tpe.id as tpe_id,
        tpe.plan_file_id as tpe_plan_file_id,
        tpe.plan_file_name as tpe_plan_file_name,
        tpe.status as tpe_status,
        tpe.executor as tpe_executor,
        tpe.start_time as tpe_start_time,
        tpe.end_time as tpe_end_time,
        tpe.last_feed_back_time as tpe_last_feed_back_time,
        tpf.id as tpf_id,
        tpf.name as tpf_name,
        tpf.file_id as tpf_file_id,
        tpf.directory_id as tpf_directory_id,
        tpf.description as tpf_description,
        tpf.preplan_priority as tpf_preplan_priority,
        tpf.disaster_type as tpf_disaster_type,
        tpf.applicable_area as tpf_applicable_area,
        tpf.entity_category_id as tpf_entity_category_id,
        tpf.entity_category_property as tpf_entity_category_property,
        tpf.created_at as tpf_created_at,
        tpf.updated_at as tpf_updated_at
        from
        t_plan_exe tpe
            LEFT JOIN t_plan_file tpf on tpe.plan_file_id = tpf.id
        <where>
            <if test="query.planFileId != null">
                and tpf.id = #{query.planFileId}
            </if>
            <if test="query.startTime != null">
                and tpf.created_at &gt;= #{query.startTime}
            </if>
            <if test="query.endTime != null">
                and tpf.created_at &lt;= #{query.endTime}
            </if>
            <if test="query.status != null">
                and tpe.status = #{query.status}
            </if>
        </where>
    </select>
